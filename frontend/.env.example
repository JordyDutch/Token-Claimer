# ─── RPC ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_LUKSO_RPC=https://rpc.mainnet.lukso.network
NEXT_PUBLIC_TESTNET_LUKSO_RPC=https://rpc.testnet.lukso.network

# ─── LSP26 follower registry ────────────────────────────────────────────────
# Server/deploy scripts use this for follower and follow-address requirements.
LSP26_REGISTRY=0xf01103E5a9909Fc0DBe8166dA7085e0285daDDcA
# Optional if testnet uses a different LSP26 registry in your deployment setup.
TESTNET_LSP26_REGISTRY=

# ─── Factory contracts ───────────────────────────────────────────────────────
# Active mainnet factories used for new drops.
NEXT_PUBLIC_LSP7_FACTORY=0x0B38Ca584553Ec7dA412403c9537B2C0Cd094bf0
NEXT_PUBLIC_LSP8_FACTORY=0xdcA867387df33b9ce08B706fdb91FB2e8C4bEB74

# Active testnet factories used for new drops on testnet.
NEXT_PUBLIC_TESTNET_LSP7_FACTORY=0x51480Ab4EB8529846d495AA9745dcc0B39362Ebe
NEXT_PUBLIC_TESTNET_LSP8_FACTORY=0xE0FEC12979636dE2a747B7F6944aD263FC58c85A

# ─── IPFS (server-side only — never sent to the browser) ────────────────────
# Get free JWT at https://pinata.cloud → Developers → API Keys → New Key
# Scopes: pinFileToIPFS + pinJSONToIPFS
PINATA_JWT=

# ─── Secret Drops (off-chain module, server-side only) ───────────────────────
# Required only for /secret-drop routes; not used by on-chain token/NFT drops.
KV_REST_API_URL=
KV_REST_API_TOKEN=
