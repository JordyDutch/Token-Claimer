# Deployer private key (Universal Profile controller)
PRIVATE_KEY=0x...

# Drop settings
TOKEN_TYPE=LSP8          # LSP7 (fungible) or LSP8 (NFT)
NFT_NAME=Livestream Drop
NFT_SYMBOL=DROP
MAX_SUPPLY=0             # 0 = unlimited
AMOUNT_PER_CLAIM=1       # LSP7: token amount (e.g. 1000000), LSP8: NFTs per claim (e.g. 10)
DECIMALS=18              # LSP7 only
